    "/t/{tenantCode}/products/{productId}/media/{mediaId}/image": {
      "get": {
        "operationId": "MediaImageController_serve",
        "parameters": [
          {
            "name": "productId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "mediaId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "size",
            "required": false,
            "in": "query",
            "description": "Image variant to serve. `display` (default) is the WebP rendition capped at 1024 px, `thumb` the one capped at 256 px, and `original` the full-size rendition after EXIF orientation correction, re-encoded to WebP (not a byte-for-byte copy of the upload).",
            "schema": {
              "default": "display",
              "type": "string",
              "enum": [
                "original",
                "thumb",
                "display"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "tags": [
          "MediaImage"
        ]
